# Rust at the currently required O0 release setting has larger main-task frames
# than the ESP-IDF C default. Keep enough headroom for hardware setup and HTTP
# request deserialization before worker tasks start.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Enable ESP-IDF HTTP server WebSocket support for live calibration telemetry.
CONFIG_HTTPD_WS_SUPPORT=y

# Keep ESP-IDF's standard 100 Hz kernel tick. Servo timing is driven by the
# servo's hardware timer, rather than by the RTOS scheduler tick.
#CONFIG_FREERTOS_HZ=1000

# Workaround for https://github.com/espressif/esp-idf/issues/7631
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
#CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=n
